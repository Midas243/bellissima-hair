# Copiez ce fichier en ".env" (ou définissez ces variables chez votre hébergeur)

# Port d'écoute (la plupart des hébergeurs le définissent eux-mêmes)
PORT=3000

# IMPORTANT : compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@votredomaine.com
ADMIN_PASSWORD=ChangezMoi-Mot2PasseSolide!

# Clé secrète pour signer les sessions (32+ caractères aléatoires).
# Si vide, une clé est générée et conservée dans le dossier data/.
SECRET=

# Dossier de la base de données SQLite (à placer sur un disque persistant)
DATA_DIR=./data

# Données de démonstration au premier démarrage (true/false)
SEED_DEMO=true

# Paiements : "simulation" tant que les API M-Pesa / Airtel / Orange / Visa ne sont pas branchées
PAYMENT_MODE=simulation

# Frais de livraison fixes en USD
DELIVERY_FEE=3

# Mettre à 1 derrière un proxy/hébergeur (Render, Railway, Nginx...) pour lire la vraie IP
TRUST_PROXY=1
